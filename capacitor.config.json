{
  "appId": "de.davaigo.app",
  "appName": "Davaigo",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#f5f0fc"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#f5f0fc",
      "showSpinner": false
    }
  },
  "ios": {
    "backgroundColor": "#f5f0fc",
    "limitsNavigationsToAppBoundDomains": false,
    "contentInset": "always"
  }
}

# Davaigo-Frontend: statische Dateien mit SPA-Regel.
#
# Die App verwaltet ihre "Seiten" selbst. Ruft jemand direkt
# /spotify oder /impressum auf, gibt es dafür keine Datei –
# try_files schickt solche Adressen an index.html, und die App
# entscheidet dann, was zu zeigen ist.

:80 {
	root * /srv
	encode gzip zstd

	# Fertige Dateien (mit Prüfsumme im Namen) dürfen lange im Cache bleiben
	@statisch path /assets/* /audio/*
	header @statisch Cache-Control "public, max-age=31536000, immutable"

	# Die Store-App holt die Aufnahmen von hier, läuft dabei aber unter
	# einer anderen Herkunft (capacitor/localhost). Das <audio>-Element
	# selbst bräuchte das nicht – die HEAD-Abfrage in src/audio.js, mit
	# der die App prüft, ob es eine Aufnahme gibt, sehr wohl. Ohne
	# diesen Kopf schlägt sie fehl und es spräche überall die
	# Gerätestimme.
	@audio path /audio/*
	header @audio Access-Control-Allow-Origin "*"

	# Die App-Seite NIE cachen – sonst sehen Nutzer nach einem Update die
	# alte App. Nicht "/index.html" als Pfad: Die Startseite wird als "/"
	# angefragt, und dort griff die alte Regel nie (wie in Habloo).
	@seite not path /assets/* /audio/* /manifest.webmanifest /apple-touch-icon*.png /icon-*.png /favicon.svg /ratgeber/* /sitemap.xml /robots.txt
	header @seite Cache-Control "no-cache"

	# Das Web-App-Manifest braucht seinen eigenen Typ. Go kennt die
	# Endung .webmanifest nicht, Caddy würde sonst raten – und Chrome
	# meckert dann in der Konsole herum. Kurz cachen, damit ein neues
	# Symbol nicht tagelang unentdeckt bleibt.
	header /manifest.webmanifest {
		Content-Type "application/manifest+json"
		Cache-Control "public, max-age=3600"
	}

	# Symbole mit Nummer im Namen ändern sich nie – die dürfen ewig
	# liegen bleiben. Ändert sich das Bild, ändert sich der Name.
	@symbole path /apple-touch-icon-*.png /icon-*.png
	header @symbole Cache-Control "public, max-age=31536000, immutable"

	# Die Fassung ohne Nummer liegt nur da, weil manche Dienste stur
	# die Wurzeladresse abfragen. Kurz cachen, sonst klebt sie fest.
	header /apple-touch-icon.png Cache-Control "public, max-age=3600"
	header /favicon.svg Cache-Control "public, max-age=3600"

	# Ratgeberseiten und Sitemap: kurz cachen, damit Korrekturen
	# schnell ankommen.
	@ratgeber path /ratgeber/* /sitemap.xml /robots.txt
	header @ratgeber Cache-Control "public, max-age=1800"

	# {path}/index.html muss mit rein, sonst landet /ratgeber/foo/ bei
	# der SPA-Regel und zeigt die App statt des Ratgebers.
	try_files {path} {path}/index.html /index.html
	file_server
}

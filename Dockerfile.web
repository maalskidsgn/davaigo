# Bauanleitung für das Davaigo-FRONTEND (die Web-App im Browser).
#
# Zwei Stufen: Erst baut Node die App zu fertigen Dateien, dann
# liefert ein winziger Caddy-Server sie aus. Der fertige Container
# enthält kein Node mehr – nur die Dateien und den Webserver.
#
# WICHTIG: Die VITE_-Werte werden BEIM BAUEN fest eingebacken, nicht
# beim Starten gelesen. Sie müssen in Coolify als "Build Variable"
# gesetzt sein, sonst zeigt die App ins Leere.

FROM node:22-slim AS bauen
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Diese drei Werte reicht Coolify als Build-Argumente herein
ARG VITE_API_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_API_URL=$VITE_API_URL \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# Der Build prüft zuerst den Kursaufbau (pruefe-*.mjs) und bricht
# bei einem Fehler ab – kaputte Lektionen gehen nie live.
RUN npm run build

# ---- Stufe 2: ausliefern ----
FROM caddy:2-alpine
COPY --from=bauen /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 80

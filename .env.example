# Vorlage für die Zugangsdaten. Kopiere sie zu .env.local und
# trage die echten Werte ein – .env.local landet NIE im Git.

# --- Supabase (Konten, Datenbank, Mediathek) ---
# Supabase → Project Settings → API Keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Dieselben Werte nochmal für das Frontend (Vite backt sie beim Bauen ein)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Die Adresse des eigenen Servers ---
# Lokal leer lassen (Vite leitet /api weiter). In Produktion:
# VITE_API_URL=https://api.davaigo.de
VITE_API_URL=

# --- KI ---
OPENAI_API_KEY=          # Vokabellisten und E-Books
ANTHROPIC_API_KEY=       # optional: Vokabeln aus Video-Transkripten
ELEVENLABS_API_KEY=      # Vertonung der Lektionen (scripts/vertone.mjs)

# --- YouTube ---
YOUTUBE_API_KEY=         # prüft, welche Videos Untertitel haben
TUBEALFRED_API_KEY=      # Transkripte, wenn YouTube den Server blockt

# --- Spotify (optional, für den Songs-Bereich) ---
# developer.spotify.com/dashboard, Redirect-URI: https://davaigo.de/spotify
VITE_SPOTIFY_CLIENT_ID=

# --- Stripe (Bezahlung, noch nicht aktiv) ---
STRIPE_SECRET_KEY=
STRIPE_PREIS_ID=
STRIPE_WEBHOOK_SECRET=

# Welche App das ist – Habloo und Davaigo können sich ein Stripe-Konto teilen
APP_KENNUNG=davaigo
